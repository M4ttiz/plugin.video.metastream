                    <height>40</height>
                    <font>font13</font>
                    <align>right</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(quality)]</label>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>90</top>
                    <width>1400</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FFDDDDDD</textcolor>
                    <label>$INFO[ListItem.Property(size)]</label>
