                    <left>30</left>
                    <top>14</top>
                    <width>1450</width>
                    <height>48</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(title)]</label>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>62</top>
                    <width>1400</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FFBDBDBD</textcolor>
                    <label>$INFO[ListItem.Property(provider)]</label>
                </control>
                <control type="label">
                    <right>30</right>
                    <top>34</top>
                    <width>220</width>
                    <height>40</height>
                    <font>font13</font>
                    <align>right</align>
                    <textcolor>FF9BE38F</textcolor>
                    <label>$INFO[ListItem.Property(quality)]</label>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>90</top>
                    <width>1400</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FF8C8C8C</textcolor>
                    <label>$INFO[ListItem.Property(size)]</label>
                </control>
            </itemlayout>
            <focusedlayout height="140" width="1800">
