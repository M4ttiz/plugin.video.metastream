            <left>60</left>
            <top>120</top>
            <width>1800</width>
            <height>880</height>
            <pagecontrol>60</pagecontrol>
            <focusposition>0</focusposition>
            <scrolltime tween="sine" easing="out">200</scrolltime>
            <itemlayout height="140" width="1800">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1800</width>
                    <height>132</height>
                    <texture colordiffuse="FF1E1E1E">common/white.png</texture>
                </control>
