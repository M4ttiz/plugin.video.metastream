<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
    <defaultcontrol>50</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <texture colordiffuse="FF101010">common/white.png</texture>
        </control>

        <control type="label" id="10">
            <left>70</left>
            <top>40</top>
            <width>600</width>
            <height>60</height>
            <font>font16_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>Metastream</label>
        </control>

        <control type="panel" id="50">
            <left>60</left>
            <top>120</top>
            <width>1800</width>
            <height>880</height>
            <visible>true</visible>
            <scrolltime tween="sine" easing="out">200</scrolltime>
            <focusposition>0</focusposition>
            <itemgap>12</itemgap>
            <orientation>vertical</orientation>
            <animation effect="fade" start="0" end="100" time="250" reversible="false"/>
            <itemlayout width="420" height="260">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>400</width>
                    <height>240</height>
                    <texture colordiffuse="FF1E1E1E">common/white.png</texture>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>18</top>
                    <width>360</width>
                    <height>48</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(title)]</label>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>80</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FFBDBDBD</textcolor>
                    <label>$INFO[ListItem.Property(provider)]</label>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>116</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FF8C8C8C</textcolor>
                    <label>$INFO[ListItem.Property(size)]</label>
                </control>
                <control type="label">
                    <right>18</right>
                    <top>18</top>
                    <width>120</width>
                    <height>30</height>
                    <align>right</align>
                    <font>font12</font>
                    <textcolor>FF9BE38F</textcolor>
                    <label>$INFO[ListItem.Property(quality)]</label>
                </control>
            </itemlayout>
            <focusedlayout width="420" height="260">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>400</width>
                    <height>240</height>
                    <texture colordiffuse="FF2A4F6D">common/white.png</texture>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>18</top>
                    <width>360</width>
                    <height>48</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(title)]</label>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>80</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FFE4E4E4</textcolor>
                    <label>$INFO[ListItem.Property(provider)]</label>
                </control>
                <control type="label">
                    <left>18</left>
                    <top>116</top>
                    <width>360</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>FFDDDDDD</textcolor>
                    <label>$INFO[ListItem.Property(size)]</label>
                </control>
                <control type="label">
                    <right>18</right>
                    <top>18</top>
                    <width>120</width>
                    <height>30</height>
                    <align>right</align>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(quality)]</label>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
