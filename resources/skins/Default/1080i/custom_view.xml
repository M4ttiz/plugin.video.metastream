                    <left>0</left>
                    <top>0</top>
                    <width>1800</width>
                    <height>132</height>
                    <texture colordiffuse="FF2A4F6D">common/white.png</texture>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>14</top>
                    <width>1450</width>
                    <height>48</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(title)]</label>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>62</top>
