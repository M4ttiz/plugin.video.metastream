<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window type="dialog">
    <defaultcontrol>50</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <texture colordiffuse="FF101010">common/white.png</texture>
        </control>

        <control type="label" id="10">
            <left>70</left>
            <top>40</top>
            <width>600</width>
            <height>60</height>
            <font>font16_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>Metastream</label>
        </control>

